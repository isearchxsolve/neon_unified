# Copy to .env for local tooling if desired, but do not commit real values.
# The runtime reads environment variables; your shell/CI secret store is preferred.
NIM_API_KEY=
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_DEFAULT_MODEL=z-ai/glm-5.2

# Optional OiiOii media providers
IMAGE_API_KEY=
IMAGE_API_BASE=
VIDEO_API_KEY=
VIDEO_API_BASE=
AUDIO_API_KEY=
AUDIO_API_BASE=

# Optional operational controls
NEON_SANDBOX_DOCKER=false
NEON_SANDBOX_IMAGE=neon-sandbox:latest
